  {
    "id": "pus-c8bc7f6d-af21-49d4-bd8e-918bb90b5159",
    "title": "The River At Night",
    "author": "Nandini Majundar",
    "language": "en",
    "country": "np",
    "source": "pustakalaya-stories",
    "sourceUrl": "https://pustakalaya.org/documents/detail/c8bc7f6d-af21-49d4-bd8e-918bb90b5159/",
    "coverUrl": "https://pustakalaya.org/media/uploads/op/thumbnail/bfjM0Pcx1Tqav5ZP5gRgq60IDB5GJv.gif",
    "category": "Story",
    "keywords": [
      "A picture story",
      "Illustrated Book",
      "Children's Literature",
      "The River At Night"
    ],
    "scrapedAt": "2026-05-24T10:29:41.033421Z",
    "readUrl": "https://pustakalaya.org/media/uploads/op/pdf/NandiniMajundar2012_TheRiverAtNight.pdf/NandiniMajundar2012_TheRiverAtNight.pdf",
    "fileSize": "1.31 MB",
    "illustrator": "Zarina Khatun",
    "publisher": "Eklavya",
    "pageCount": "20",
    "description": "It is night and the author whimsically imagines that the river, the steps by the river and even the trees all go to sleep. Until the wind starts up and... A creative story line,\r\n  almost as gentle as a soft lullaby being crooned in the night. This delightful book reminds me of the all-time classic Good Night Moon by Margaret Wise Brown in which a hush seems to envelop all\r\n  around the little world of the child imparting a sense of peace, tanquillity and security. Adding to the charm of the book is the innovative use of zardoshi 'sewing with gold', for the font and the\r\n  illustrations, a style of embroidery patronised by the mughal Emperors but now on a decline."
  },

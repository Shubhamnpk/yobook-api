  {
    "id": "pus-87b29be5-d7cf-45ec-a346-7f47f3ab761e",
    "title": "English-Nepali Glossary of Federalism Terms",
    "author": "Unknown",
    "language": "ne",
    "country": "np",
    "source": "pustakalaya-reference",
    "sourceUrl": "https://pustakalaya.org/documents/detail/87b29be5-d7cf-45ec-a346-7f47f3ab761e/",
    "coverUrl": "https://pustakalaya.org/media/uploads/op/thumbnail/SEWfQy9cLx7UN9mJ9yij18dy2JWVP2.jpg",
    "category": "Reference",
    "keywords": [
      "English-Nepali Glossary of Federalism Terms",
      "सङ्घीयतासम्बन्धी अङ्ग्रेजी - नेपाली शब्दावली",
      "Policy and Political Science",
      "International IDEA",
      "The Forum of Federations"
    ],
    "scrapedAt": "2026-05-24T10:52:06.830194Z",
    "readUrl": "https://pustakalaya.org/media/uploads/op/pdf/IDEA2009_English-NepaliGlossaryOfFederalismTerms.pdf/IDEA2009_English-NepaliGlossaryOfFederalismTerms.pdf",
    "fileSize": "0.96 MB",
    "publisher": "Forum of Federations, \n                     \n                        International Institute for Democracy and Electoral Assistance (IDEA)",
    "pageCount": "92",
    "description": "Many people in Nepal see federalism as a way to empower communities and regions marginalised by the centralization of power, and to acknowledge and further promote the country’s\r\n  religious, linguistic and ethnic diversity. Understanding federalism and discussing its key issues and options are at the core of the current constitution making debate. This Glossary offers\r\n  definitions for some 300 federal terms and their translation into Nepali. It will help foster a common understanding of the key terms used in federal arrangements. It will also serve as a tool to\r\n  explain federal concepts to individuals and groups as they engage in the process of preparing submissions and proposals to the Constituent Assembly. Finally, the Glossary will help in the\r\n  standardization of Nepali constitutional terminology and contribute to the development of plain language drafting of legal and constitutional texts in the country."
  },
